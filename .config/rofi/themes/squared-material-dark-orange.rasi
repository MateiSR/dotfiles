/*****----- Configuration -----*****/
configuration {
    modi:                   "drun";
    show-icons:             true;
    display-drun:           " ";
    drun-display-format:    "{name}";
}

* {
    font:                   "FiraCode Nerd Font Medium 12";

    bg0:                    rgba(12, 9, 8, 0.9);
    bg1:                    rgba(40, 35, 29, 0.95);
    fg0:                    #c5bfae;

    accent-color:           #b36b20;
    urgent-color:           #b8860B;

    background-color:       transparent;
    text-color:             @fg0;

    margin:                 0;
    padding:                0;
    spacing:                0;
}

window {
    location:               center;
    width:                  480;
    background-color:       @bg0;
    border-radius:          4px;
}

inputbar {
    spacing:                8px;
    padding:                8px;
    background-color:       @bg1;
}

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

prompt {
    text-color: @accent-color;
}

textbox {
    padding:                8px;
    background-color:       @bg1;
}

listview {
    padding:                4px 0;
    lines:                  8;
    columns:                1;
    fixed-height:           false;
}

element {
    padding:                8px;
    spacing:                8px;
}

element normal normal {
    text-color: @fg0;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

element selected {
    text-color: @bg0;
}

element selected normal, element selected active {
    background-color:       @accent-color;
}

element selected urgent {
    background-color:       @urgent-color;
}

element-icon {
    size:                   0.8em;
}

element-text {
    text-color: inherit;
}
