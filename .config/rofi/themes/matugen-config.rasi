/*****----- Configuration -----*****/
configuration {
    modi:                   "drun";
    show-icons:             true;
    display-drun:           " ";
    drun-display-format:    "{name}";
}

/*****----- Matugen Colors -----*****/
@import                  "../colors/matugen.rasi"

* {
    /* Main Theme Colors */
    bg0:                     @surface-container-low;
    bg1:                     @surface-container;
    fg0:                     @on-surface;
    accent-color:            @primary;
    urgent-color:            @tertiary;

    /* General Settings */
    font:                    "FiraCode Nerd Font Medium 12";
    background-color:        transparent;
    text-color:              @fg0;
    margin:                  0;
    padding:                 0;
    spacing:                 0;
}

/*****----- Main Window -----*****/
window {
    location:                center;
    width:                   480;
    background-color:        @bg0;
    border-radius:           12px;
    // border:                  1px solid @outline-variant;
}

/*****----- Input Bar -----*****/
inputbar {
    spacing:                 8px;
    padding:                 12px;
    background-color:        @bg1;
    children:                [ prompt, entry ];
}

prompt, entry, element-icon, element-text {
    vertical-align:          0.5;
}

prompt {
    text-color:              @accent-color;
}

/*****----- List View -----*****/
listview {
    padding:                 8px 0;
    lines:                   8;
    columns:                 1;
    fixed-height:            false;
}

element {
    padding:                 8px;
    spacing:                 8px;
    border-radius:           8px;
}

element normal normal {
    text-color:              @fg0;
}

element normal urgent {
    text-color:              @urgent-color;
}

element normal active {
    text-color:              @accent-color;
}

element alternate active {
    text-color:              @accent-color;
}

element selected {
    text-color:              @on-primary;
}

element selected normal, element selected active {
    background-color:        @accent-color;
}

element selected urgent {
    background-color:        @urgent-color;
}

element-icon {
    size:                    1.2em;
    padding:                 0 4px 0 0;
}

element-text {
    text-color:              inherit;
}
