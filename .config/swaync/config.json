{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-width": 500,
    "control-center-height": 700,
    "notification-window-width": 450,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-action": true,
    "widgets": [
        "title",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear All"
        },
        "dnd": {
            "text": "Do Not Disturb"
        }
    },
    "notification-visibility": {
        "normal": {
            "state": "visible"
        }
    },
    "script-fail-notify": true,
    "scripts": {
        "soundsLow": {
            "exec": "play -v 0.2 /usr/share/sounds/ocean/stereo/dialog-information.oga",
            "urgency": "Low"
        },
        "soundsNorm": {
            "exec": "play -v 0.2 /usr/share/sounds/ocean/stereo/dialog-warning.oga",
            "urgency": "Normal"
        },
        "soundsCrit": {
            "exec": "play -v 0.2 /usr/share/sounds/ocean/stereo/dialog-error.oga",
            "urgency": "Critical"
        }
    },
    "timeout": 2,
    "timeout-low": 2,
    "timeout-normal": 2,
    "timeout-critical": 0
}
