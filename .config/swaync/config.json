{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-positionX": "right",
    "control-center-positionY": "top",
    "control-center-layer": "overlay",
    "control-center-margin-top": 52,
    "control-center-margin-right": 8,
    "control-center-exclusive-zone": false,
    "control-center-width": 430,
    "control-center-height": -1,
    "notification-window-width": 410,
    "fit-to-screen": false,
    "ignore-gtk-theme": true,
    "cssPriority": "user",
    "keyboard-shortcuts": true,
    "notification-grouping": true,
    "notification-inline-replies": true,
    "notification-icon-size": 48,
    "image-visibility": "when-available",
    "relative-timestamps": true,
    "transition-time": 180,
    "hide-on-action": true,
    "hide-on-clear": false,
    "text-empty": "All caught up",
    "widgets": [
        "title",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "dnd": {
            "text": "Do not disturb"
        }
    },
    "notification-visibility": {
        "spotify": {
            "state": "ignored",
            "app-name": "Spotify"
        },
        "normal": {
            "state": "visible"
        }
    },
    "script-fail-notify": true,
    "scripts": {
        "soundsLow": {
            "exec": "play -v 0.2 /usr/share/sounds/ocean/stereo/dialog-information.oga",
            "urgency": "Low"
        },
        "soundsNorm": {
            "exec": "play -v 0.2 /usr/share/sounds/ocean/stereo/dialog-warning.oga",
            "urgency": "Normal"
        },
        "soundsCrit": {
            "exec": "play -v 0.2 /usr/share/sounds/ocean/stereo/dialog-error.oga",
            "urgency": "Critical"
        }
    },
    "timeout": 2,
    "timeout-low": 2,
    "timeout-critical": 0
}
