.config/gtk-3.0/gtk.css
.config/gtk-4.0/colors.css
.config/hypr/matugen.lua
.config/hypr/matugen.conf
.config/kitty/matugen.conf
.config/kitty/current-theme.conf
.config/qt5ct/colors/matugen.conf
.config/qt6ct/colors/matugen.conf
.config/rofi/colors/matugen.rasi
.config/starship.toml
.config/swaync/matugen.css
.config/waybar/config.jsonc
.config/waybar/matugen.css
.config/waypaper/config.ini
.config/wlogout/matugen.css
.config/yazi/theme.toml
.config/dotfiles/machine.lua
.config/dotfiles/git.conf
.config/dotfiles/scripts/gs_zipline_conf.sh
.config/fish/functions/fish_prompt.fish
